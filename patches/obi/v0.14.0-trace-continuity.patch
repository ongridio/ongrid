+
+static __always_inline void mark_sdk_client(const go_addr_key_t *g_key, const tp_info_t *tp) {
+    http_func_invocation_t *http = bpf_map_lookup_elem(&go_ongoing_http_client_requests, g_key);
+    if (http && sdk_covers_client(tp, &http->tp)) {
+        http->tp = *tp;
+        http->tp.sdk_owned = 1;
+    }
+    grpc_client_func_invocation_t *grpc = bpf_map_lookup_elem(&ongoing_grpc_client_requests, g_key);
