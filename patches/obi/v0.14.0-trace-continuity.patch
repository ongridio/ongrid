+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#include <assert.h>
+#include <string.h>
+#include <bpfcore/bpf_core_read.h>
+#include <bpfcore/bpf_helpers.h>
+#undef BPF_CORE_READ
+#define BPF_CORE_READ(src, ...) ___bpf_apply(___bpf_arrow, ___bpf_narg(__VA_ARGS__))(src, __VA_ARGS__)
+#define bpf_probe_read_kernel(dst, size, src) (memcpy(dst, src, size), 0)
+#include <gotracer/go_observer_pid.h>
+
+int main(void) {
+    struct pid_namespace root = {.ns = {.inum = 10}};
+    struct pid_namespace observer = {.ns = {.inum = 20}};
+    struct pid_namespace app = {.ns = {.inum = 30}};
+    struct pid process = {
+        .level = 2,
+        .numbers = {{.nr = 4000, .ns = &root},
+                    {.nr = 2000, .ns = &observer},
+                    {.nr = 1, .ns = &app}},
+    };
+    assert(go_pid_in_namespace(&process, 10) == 4000);
+    assert(go_pid_in_namespace(&process, 20) == 2000);
+    assert(go_pid_in_namespace(&process, 30) == 1);
+    assert(go_pid_in_namespace(&process, 40) == 0);
+    assert(go_pid_in_namespace(&process, 0) == 0);
+    assert(go_pid_in_namespace(NULL, 20) == 0);
+    process.level = 0;
+    assert(go_pid_in_namespace(&process, 10) == 4000);
+    assert(go_pid_in_namespace(&process, 20) == 0);
+    process.level = 33;
+    assert(go_pid_in_namespace(&process, 10) == 0);
+    return 0;
+}
