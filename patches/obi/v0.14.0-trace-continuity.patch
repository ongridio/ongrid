diff --git a/bpf/gotracer/go_observer_pid.h b/bpf/gotracer/go_observer_pid.h
new file mode 100644
index 0000000..f165444
--- /dev/null
+++ b/bpf/gotracer/go_observer_pid.h
@@ -0,0 +1,45 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <bpfcore/vmlinux.h>
+#include <bpfcore/bpf_helpers.h>
+#include <bpfcore/bpf_core_read.h>
+
+volatile const u32 g_go_observer_pid_ns = 0;
+
+// Userspace map keys use OBI's PID namespace, which need not be the kernel root.
+static __always_inline u32 go_pid_in_namespace(struct pid *pid, u32 ns) {
+    if (!pid || !ns) {
+        return 0;
+    }
+    const u32 depth = BPF_CORE_READ(pid, level);
+    if (depth > 32) {
+        return 0;
+    }
+    for (u32 level = 0; level <= 32; level++) {
+        if (level > depth) {
+            break;
+        }
+        struct upid id = {};
+        if (bpf_probe_read_kernel(&id, sizeof(id), &pid->numbers[level]) != 0) {
+            return 0;
+        }
+        if (BPF_CORE_READ(id.ns, ns.inum) == ns) {
+            return id.nr;
+        }
+    }
+    return 0;
+}
+
+static __always_inline u32 go_observer_pid() {
+    struct task_struct *task = (struct task_struct *)bpf_get_current_task();
+    return go_pid_in_namespace(BPF_CORE_READ(task, group_leader, thread_pid),
+                               g_go_observer_pid_ns);
+}
+
+static __always_inline u32 go_observer_tid() {
+    struct task_struct *task = (struct task_struct *)bpf_get_current_task();
+    return go_pid_in_namespace(BPF_CORE_READ(task, thread_pid), g_go_observer_pid_ns);
+}
