+func TestSDKContextRetainsOnlyUncoveredOperation(t *testing.T) {
+	selection := instrumentations.NewInstrumentationSelection([]instrumentations.Instrumentation{instrumentations.InstrumentationHTTP})
+	span := request.Span{Type: request.EventTypeHTTPClient}
+	span.Service.SetExportsOTelTraces()
+	assert.True(t, SpanDiscarded(&span, selection))
+	span.SDKContext = true
+	assert.False(t, SpanDiscarded(&span, selection))
+	request.SetIgnoreTraces(&span)
+	assert.True(t, SpanDiscarded(&span, selection))
+}
+
+func TestGroupSpansRespectsCapturedParentSampling(t *testing.T) {
+	selection := instrumentations.NewInstrumentationSelection([]instrumentations.Instrumentation{instrumentations.InstrumentationALL})
+	for _, eventType := range []request.EventType{request.EventTypeHTTP, request.EventTypeHTTPClient, request.EventTypeManualSpan} {
+		for _, flags := range []uint8{0, 1} {
+			span := request.Span{Type: eventType, TraceID: trace2.TraceID{1}, ParentSpanID: trace2.SpanID{2}, TraceFlags: flags}
+			groups := GroupSpans(t.Context(), []request.Span{span}, nil, sdktrace.ParentBased(sdktrace.AlwaysSample()), selection)
+			assert.Len(t, groups[span.Service.UID], int(flags))
+			groups = GroupSpans(t.Context(), []request.Span{span}, nil, sdktrace.AlwaysSample(), selection)
+			assert.Len(t, groups[span.Service.UID], 1)
+			span.ParentSpanID = trace2.SpanID{}
+			groups = GroupSpans(t.Context(), []request.Span{span}, nil, sdktrace.ParentBased(sdktrace.AlwaysSample()), selection)
+			assert.Len(t, groups[span.Service.UID], 1)
+		}
+	}
+}
