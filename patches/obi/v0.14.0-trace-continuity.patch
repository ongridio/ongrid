+                                                    tp_info_t *tp,
+                                                    const void *value,
+                                                    u64 len) {
+    if (!tp || len != W3C_VAL_LENGTH) {
+        return;
+    }
+    tp_info_t *sdk = bpf_map_lookup_elem(&go_trace_map, key);
+    if (!sdk || sdk->sdk_kind != k_go_sdk_span_client ||
+        __builtin_memcmp(sdk->trace_id, tp->trace_id, sizeof(tp->trace_id)) ||
+        __builtin_memcmp(sdk->span_id, tp->parent_id, sizeof(tp->parent_id))) {
+        return;
+    }
+    unsigned char header[W3C_VAL_LENGTH];
+    if (!bpf_probe_read_user(header, sizeof(header), value) &&
+        sdk_client_parent_matches_header(tp, header)) {
+        *tp = *sdk;
+        tp->sdk_owned = 1;
+    }
+}
