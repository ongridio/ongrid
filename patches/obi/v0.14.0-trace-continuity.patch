+    const u64 kind_off = go_offset_of(ot, (go_offset){.v = _auto_sdk_data_kind_pos});
+    const u64 parent_off = go_offset_of(ot, (go_offset){.v = _auto_sdk_data_parent_pos});
+    if (data_off == (u64)-1 || kind_off == (u64)-1 || parent_off == (u64)-1) {
