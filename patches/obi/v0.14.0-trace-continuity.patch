+    go_addr_key_from_id(&s_key, span);
+    tp_info_t *prev = bpf_map_lookup_elem(&go_trace_map, &g_key);
+    if (prev) {
+        state.prev_tp = *prev;
+    }
+    if (bpf_map_update_elem(&active_go_sdk_spans, &s_key, &state, BPF_NOEXIST)) {
+        return 0;
+    }
+    mark_sdk_server(&g_key, &state.child_tp);
+    mark_sdk_client(&g_key, &state.child_tp);
+    bpf_map_update_elem(&go_trace_map, &g_key, &state.child_tp, BPF_ANY);
