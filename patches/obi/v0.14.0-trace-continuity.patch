+func TestGoSDKContextSurvivesDatabaseConversion(t *testing.T) {
+	for _, owned := range []uint8{0, 1} {
+		sql := SQLRequestTrace{Type: uint8(request.EventTypeSQLClient)}
+		sql.Tp.SdkContext, sql.Tp.SdkOwned, sql.Tp.Flags = 1, owned, 1
+		redis := GoRedisClientInfo{}
+		redis.Tp.SdkContext, redis.Tp.SdkOwned, redis.Tp.Flags = 1, owned, 1
+		mongo := GoMongoClientInfo{}
+		mongo.Tp.SdkContext, mongo.Tp.SdkOwned, mongo.Tp.Flags = 1, owned, 1
+		copy(mongo.Op[:], "find")
+		kafka := GoKafkaGoClientInfo{}
+		kafka.Tp.SdkContext, kafka.Tp.SdkOwned, kafka.Tp.Flags = 1, owned, 1
+		decode := func(event any, reader func(*ringbuf.Record) (request.Span, bool, error)) request.Span {
+			var raw bytes.Buffer
+			require.NoError(t, binary.Write(&raw, binary.LittleEndian, event))
+			span, ignored, err := reader(&ringbuf.Record{RawSample: raw.Bytes()})
+			require.NoError(t, err)
+			require.False(t, ignored)
+			return span
+		}
+		for _, span := range []request.Span{SQLRequestTraceToSpan(&sql), goRedisSpan(&redis, "GET", "GET key"), decode(mongo, ReadGoMongoRequestIntoSpan), decode(kafka, ReadGoKafkaGoRequestIntoSpan)} {
+			assert.True(t, span.SDKContext)
+			assert.Equal(t, uint8(1), span.TraceFlags)
+			assert.Equal(t, owned != 0, request.IgnoreTraces(&span))
+			assert.False(t, request.IgnoreMetrics(&span))
+		}
+	}
+}
