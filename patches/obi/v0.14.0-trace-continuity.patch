+
+static __always_inline u8 sdk_covers_server(const tp_info_t *sdk, const tp_info_t *obi) {
+    return sdk->sdk_kind == k_go_sdk_span_server && !obi->sdk_owned &&
+           *((u64 *)sdk->trace_id) == *((u64 *)obi->trace_id) &&
+           *((u64 *)(sdk->trace_id + 8)) == *((u64 *)(obi->trace_id + 8)) &&
