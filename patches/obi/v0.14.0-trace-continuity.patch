+static __always_inline u8 read_sdk_span_context(void *sc, tp_info_t *tp) {
+    off_table_t *ot = get_offsets_table();
+    if (!ot || !sc) {
+        return 0;
+    }
+    const u64 tid = go_offset_of(ot, (go_offset){.v = _span_context_trace_id_pos});
+    const u64 sid = go_offset_of(ot, (go_offset){.v = _span_context_span_id_pos});
+    const u64 flags = go_offset_of(ot, (go_offset){.v = _span_context_trace_flags_pos});
+    if (tid == (u64)-1 || sid == (u64)-1 || flags == (u64)-1) {
+        return 0;
+    }
+    if (bpf_probe_read_user(tp->trace_id, sizeof(tp->trace_id), sc + tid) ||
+        bpf_probe_read_user(tp->span_id, sizeof(tp->span_id), sc + sid) ||
+        bpf_probe_read_user(&tp->flags, sizeof(tp->flags), sc + flags)) {
+        return 0;
+    }
+    tp->ts = bpf_ktime_get_ns();
+    tp->sdk_context = 1;
+    return valid_trace(tp->trace_id) && valid_span(tp->span_id);
