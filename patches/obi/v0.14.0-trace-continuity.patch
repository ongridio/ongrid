+    grpc_srv_func_invocation_t *grpc = bpf_map_lookup_elem(&ongoing_grpc_server_requests, g_key);
+    if (grpc && sdk_covers_server(tp, &grpc->tp)) {
+        grpc->tp.sdk_owned = 1;
+    }
