+static __always_inline bool sdk_client_parent_matches_header(const tp_info_t *tp,
+                                                              const unsigned char *header) {
+    if (!tp->sdk_context || tp->sdk_parent_kind != k_go_sdk_span_client) {
+        return false;
+    }
+    unsigned char expected[W3C_VAL_LENGTH] = {'0', '0', '-'};
+    encode_hex(expected + 3, tp->trace_id, TRACE_ID_SIZE_BYTES);
+    expected[35] = '-';
+    encode_hex(expected + 36, tp->parent_id, SPAN_ID_SIZE_BYTES);
+    expected[52] = '-';
+    expected[53] = '0';
+    expected[54] = tp->flags ? '1' : '0';
+    return __builtin_memcmp(expected, header, sizeof(expected)) == 0;
+}
