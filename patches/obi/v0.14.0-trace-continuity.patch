+func TestSDKOwnedOperationRetainsMetrics(t *testing.T) {
+	for _, eventType := range []uint8{uint8(request.EventTypeHTTP), uint8(request.EventTypeHTTPClient), uint8(request.EventTypeGRPC), uint8(request.EventTypeGRPCClient)} {
+		event := makeHTTPRequestTrace("GET", "/work", 200, 0, 0, 1)
+		event.Type = eventType
+		event.Tp.SdkContext = 1
+		span := HTTPRequestTraceToSpan(nil, &event)
+		assert.True(t, span.SDKContext)
+		assert.False(t, request.IgnoreTraces(&span))
+		event.Tp.SdkOwned = 1
+		span = HTTPRequestTraceToSpan(nil, &event)
+		assert.True(t, request.IgnoreTraces(&span))
+		assert.False(t, request.IgnoreMetrics(&span))
+	}
+}
