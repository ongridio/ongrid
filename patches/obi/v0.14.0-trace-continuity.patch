+           *((u64 *)sdk->trace_id) == *((u64 *)obi->trace_id) &&
+           *((u64 *)(sdk->trace_id + 8)) == *((u64 *)(obi->trace_id + 8)) &&
+           *((u64 *)sdk->parent_id) == *((u64 *)obi->parent_id);
