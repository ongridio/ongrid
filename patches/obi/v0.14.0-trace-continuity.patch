+    void *entries = GO_PARAM1(ctx);
+    const s64 count = (s64)GO_PARAM2(ctx);
+    // shortcut: skip injection beyond 512 names; extend the scan when larger header sets are needed.
+    if (count < 0 || count > 512 || (count && !entries)) {
+        goto preserve;
+    }
+    for (u32 i = 0; i < 512; i++) {
+        if (i >= count) {
+            break;
+        }
+        struct header_key_values kv = {};
+        if (bpf_probe_read_user(&kv, sizeof(kv), entries + i * sizeof(kv))) {
+            goto preserve;
