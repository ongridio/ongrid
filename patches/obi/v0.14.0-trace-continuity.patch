+// Inspect the sorted header names before any large value can flush the writer.
+SEC("uprobe/header_sortedKeyValues_returns")
+int GUARDED_PROG(obi_uprobe_sortedKeyValues_returns, struct pt_regs *, ctx) {
+    if (!g_bpf_header_propagation || !g_bpf_probe_write_user_enabled) {
+        return 0;
+    }
+    go_addr_key_t g_key = {};
+    go_addr_key_from_id(&g_key, GOROUTINE_PTR(ctx));
+    write_subset_invocation_t *inv = bpf_map_lookup_elem(&ongoing_write_subsets, &g_key);
+    if (!inv) {
+        return 0;
+    }
+    struct header_key_values {
+        go_string_t key;
+        go_slice_t values;
+    };
+    void *entries = GO_PARAM1(ctx);
+    const s64 count = (s64)GO_PARAM2(ctx);
+    // shortcut: skip injection beyond 512 names; extend the scan when larger header sets are needed.
+    if (count < 0 || count > 512 || (count && !entries)) {
+        goto preserve;
+    }
+    for (u32 i = 0; i < 512; i++) {
+        if (i >= count) {
+            break;
+        }
+        struct header_key_values kv = {};
+        if (bpf_probe_read_user(&kv, sizeof(kv), entries + i * sizeof(kv))) {
+            goto preserve;
+        }
+        if (kv.key.len != W3C_KEY_LENGTH || kv.values.len <= 0) {
+            continue;
+        }
+        unsigned char name[W3C_KEY_LENGTH] = {};
+        if (bpf_probe_read_user(name, sizeof(name), kv.key.str)) {
+            goto preserve;
+        }
+        if (stricmp((const char *)name, "traceparent", W3C_KEY_LENGTH)) {
+            goto preserve;
+        }
+    }
+    return on_writeSubset_returns(ctx, bpf_strstr_tp_loop, false);
+preserve:
+    finish_http1_header_propagation(inv->req_goaddr);
+    bpf_map_delete_elem(&ongoing_write_subsets, &g_key);
+    return 0;
 }
 
