index 59da97e..43a65e0 100644
--- a/bpf/tests/bpf_go_client_trace_parent.c
+++ b/bpf/tests/bpf_go_client_trace_parent.c
@@ -107,9 +107,97 @@ static void parent_is_a_sql_wrapper(void) {
     expect(valid_span(tp.span_id), true, "the adopted client call still gets its own span id");
 }
 
+static void sql_stack_growth_preserves_query(void) {
+    sql_func_invocation_t invocation = {.start_monotime_ns = 1, .stack_off = 128};
+    go_addr_key_t key = {.addr = 0x1234};
+    bpf_map_lookup_elem_hook = sql_wrapper_lookup;
+    sql_wrapper = NULL;
+    expect(sql_query_started(&key, 128), false, "a first SQL query starts normally");
+    sql_wrapper = &invocation;
+    expect(sql_query_started(&key, 128), true,
+           "stack growth must keep the existing query and its parent context");
+    expect(sql_query_started(&key, 256), false,
+           "a deeper nested SQL call is a separate operation");
+    invocation.start_monotime_ns = 0;
+    expect(sql_query_started(&key, 128), false, "an unstarted query is not a replay");
+    bpf_map_lookup_elem_hook = NULL;
+}
+
+static tp_info_t *sdk_parent;
+
+static void *sdk_parent_lookup(void *map, const void *key) {
+    return map == &go_trace_map ? sdk_parent : NULL;
+}
+
+static long read_user_memory(void *dst, unsigned int size, const void *src) {
+    memcpy(dst, src, size);
+    return 0;
+}
+
+static void parent_is_sdk_span(void) {
+    tp_info_t parent = {.sdk_context = 1, .sdk_kind = k_go_sdk_span_client};
+    memset(parent.trace_id, 0x11, sizeof(parent.trace_id));
+    memset(parent.span_id, 0x22, sizeof(parent.span_id));
+    memset(parent.parent_id, 0x33, sizeof(parent.parent_id));
+    sdk_parent = &parent;
+    bpf_map_lookup_elem_hook = sdk_parent_lookup;
+    bpf_ktime_ns_value = 60000000000;
+    tp_info_t tp = {};
+    expect(client_trace_parent((void *)0x1234, &tp), true,
+           "active SDK context survives long operations");
+    expect(tp.sdk_context && !tp.sdk_owned && tp.flags == 0, true,
+           "raw SQL/HTTP clients inside an SDK CLIENT wrapper remain separate operations");
+    expect(memcmp(tp.parent_id, parent.span_id, sizeof(tp.parent_id)) == 0, true,
+           "uncovered client is a direct child of SDK CLIENT work");
+    expect(memcmp(tp.span_id, parent.span_id, sizeof(tp.span_id)) != 0, true,
+           "uncovered client has its own span ID");
+
+    unsigned char header[W3C_VAL_LENGTH];
+    make_tp_string(header, &parent);
+    expect(sdk_client_parent_matches_header(&tp, header), true,
+           "a request propagating this SDK CLIENT context is covered");
+    header[3] = 'f';
+    expect(sdk_client_parent_matches_header(&tp, header), false,
+           "an unrelated trace header does not establish SDK ownership");
+    make_tp_string(header, &parent);
+    header[36] = 'f';
+    expect(sdk_client_parent_matches_header(&tp, header), false,
+           "another span in the same trace does not establish SDK ownership");
+    make_tp_string(header, &parent);
+    for (u8 kind = k_go_sdk_span_internal; kind <= k_go_sdk_span_consumer; kind++) {
+        parent.sdk_kind = kind;
+        memset(&tp, 0xAB, sizeof(tp));
+        expect(client_trace_parent((void *)0x1234, &tp), true,
+               "every SDK kind provides parent context");
+        expect(tp.sdk_context && !tp.sdk_owned && !tp.sdk_kind && tp.flags == 0, true,
+               "an SDK parent alone never suppresses nested client operations");
+        expect(sdk_client_parent_matches_header(&tp, header), kind == k_go_sdk_span_client,
+               "propagating a server or internal context does not cover a client operation");
+    }
+    parent.sdk_kind = k_go_sdk_span_client;
+    client_trace_parent((void *)0x1234, &tp);
+    go_addr_key_t key = {.addr = 0x1234};
+    bpf_probe_read_user_hook = read_user_memory;
+    mark_sdk_client_header(&key, &tp, header, sizeof(header) - 1);
+    expect(tp.sdk_owned, false, "incomplete headers cannot suppress an operation");
+    sdk_parent = NULL;
+    mark_sdk_client_header(&key, &tp, header, sizeof(header));
+    expect(tp.sdk_owned, false, "missing live SDK context cannot suppress an operation");
+    sdk_parent = &parent;
+    mark_sdk_client_header(&key, &tp, header, sizeof(header));
+    expect(tp.sdk_owned && !memcmp(tp.span_id, parent.span_id, sizeof(tp.span_id)), true,
+           "confirmed SDK ownership uses the propagated span ID in every fallback");
+    expect(!memcmp(tp.parent_id, parent.parent_id, sizeof(tp.parent_id)), true,
+           "adopting SDK context preserves its real parent instead of creating a self-reference");
+    bpf_probe_read_user_hook = NULL;
+    bpf_map_lookup_elem_hook = NULL;
+}
+
 int main(void) {
     no_parent_request();
     parent_is_a_sql_wrapper();
+    sql_stack_growth_preserves_query();
+    parent_is_sdk_span();
 
     printf("OK: %s\n", __FILE__);
     return 0;
diff --git a/bpf/tests/bpf_go_grpc_server_trace_parent.c b/bpf/tests/bpf_go_grpc_server_trace_parent.c
new file mode 100644
index 0000000..c707224
--- /dev/null
+++ b/bpf/tests/bpf_go_grpc_server_trace_parent.c
@@ -0,0 +1,77 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <gotracer/maps/grpc.h>
+
+static grpc_stream_key_t keys[2];
+static tp_info_t values[2];
+static bool present[2];
+static go_addr_key_t request_key = {.pid = 100, .addr = 0x5678};
+static grpc_srv_func_invocation_t request;
+
+static int entry(void *map, const void *key) {
+    if (map != &ongoing_grpc_server_stream_tps) {
+        return -1;
+    }
+    for (int i = 0; i < 2; i++) {
+        if (present[i] && memcmp(key, &keys[i], sizeof(keys[i])) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void *lookup(void *map, const void *key) {
+    if (map == &ongoing_grpc_server_requests) {
+        return memcmp(key, &request_key, sizeof(request_key)) ? NULL : &request;
+    }
+    int i = entry(map, key);
+    return i < 0 ? NULL : &values[i];
+}
+
+static long remove_entry(void *map, const void *key) {
+    int i = entry(map, key);
+    assert(i >= 0);
+    // Model immediate LRU slot reuse by another CPU after deletion.
+    memset(&values[i], 0xee, sizeof(values[i]));
+    present[i] = false;
+    return 0;
+}
+
+int main(void) {
+    bpf_map_lookup_elem_hook = lookup;
+    bpf_map_delete_elem_hook = remove_entry;
+    for (int i = 0; i < 2; i++) {
+        keys[i] = (grpc_stream_key_t){.conn = {.pid = 100 + i, .addr = 0x1234},
+                                      .stream_id = 7};
+        memset(&values[i], 0x11 * (i + 1), sizeof(values[i]));
+        present[i] = true;
+    }
+    tp_info_t parent = {};
+    grpc_stream_key_t other = keys[0];
+    other.conn.pid = 999;
+    assert(!take_grpc_server_trace_parent(&other, &parent));
+    assert(present[0] && present[1]);
+    assert(take_grpc_server_trace_parent(&keys[0], &parent));
+    assert(parent.trace_id[0] == 0x11 && parent.parent_id[0] == 0x11);
+    assert(!present[0] && present[1]);
+    assert(!take_grpc_server_trace_parent(&keys[0], &parent));
+    assert(take_grpc_server_trace_parent(&keys[1], &parent));
+    assert(parent.trace_id[0] == 0x22 && parent.parent_id[0] == 0x22);
+    assert(!grpc_server_request_started(&request_key, 0x1234));
+    request = (grpc_srv_func_invocation_t){.start_monotime_ns = 1, .stream = 0x1234, .tp = parent};
+    assert(grpc_server_request_started(&request_key, 0x1234));
+    assert(!grpc_server_request_started(&request_key, 0x5678));
+    go_addr_key_t other_process = request_key;
+    other_process.pid++;
+    assert(!grpc_server_request_started(&other_process, 0x1234));
+    assert(request.tp.trace_id[0] == 0x22);
+    request.start_monotime_ns = 0;
+    assert(!grpc_server_request_started(&request_key, 0x1234));
+    puts("PASS gRPC parent copy-before-delete, process isolation, and repeated-entry guard");
+    return 0;
+}
