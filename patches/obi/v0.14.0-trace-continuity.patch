+    }
+    void *data = 0;
+    u32 kind = 0;
+    if (bpf_probe_read_user(&data, sizeof(data), span + data_off) || !data ||
+        bpf_probe_read_user(&kind, sizeof(kind), data + kind_off) ||
+        kind > k_go_sdk_span_consumer) {
