+        grpc_srv_func_invocation_t *grpc =
+            bpf_map_lookup_elem(&ongoing_grpc_server_requests, &g_key);
+        if ((http && sdk_covers_server(&server, &http->tp)) ||
+            (grpc && sdk_covers_server(&server, &grpc->tp))) {
