+    }
+    off_table_t *ot = get_offsets_table();
+    if (!ot) {
+        return;
+    }
+    const u64 data_off = go_offset_of(ot, (go_offset){.v = _auto_sdk_span_data_pos});
+    const u64 kind_off = go_offset_of(ot, (go_offset){.v = _auto_sdk_data_kind_pos});
+    const u64 parent_off = go_offset_of(ot, (go_offset){.v = _auto_sdk_data_parent_pos});
+    if (data_off == (u64)-1 || kind_off == (u64)-1 || parent_off == (u64)-1) {
+        return;
+    }
+    void *data = 0;
+    u32 kind = 0;
+    if (bpf_probe_read_user(&data, sizeof(data), span + data_off) || !data ||
+        bpf_probe_read_user(&kind, sizeof(kind), data + kind_off) ||
+        kind > k_go_sdk_span_consumer) {
+        return;
+    }
+    tp_info_t child = state->child_tp;
+    child.sdk_kind = kind ? kind : k_go_sdk_span_internal;
+    child.sdk_context = 1;
+    go_addr_key_t g_key = {};
+    go_addr_key_from_id(&g_key, (void *)state->goroutine);
+    if (kind == k_go_sdk_span_server && !state->prev_tp.sdk_context) {
