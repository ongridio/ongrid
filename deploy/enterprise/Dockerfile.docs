# Isolated document tools. Never installs Office into the test server host.
FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer poppler-utils fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir python-docx pdf2image pillow
WORKDIR /workspace
