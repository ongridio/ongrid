[Unit]
Description=node_exporter (ongrid host metrics)
Documentation=https://github.com/prometheus/node_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ongrid-prometheus
Group=ongrid-prometheus
ExecStart=/usr/local/bin/node_exporter --web.listen-address=127.0.0.1:19100
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=node_exporter

NoNewPrivileges=true
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
# 补 PrivateDevices=true（屏蔽 /dev 物理设备）。node_exporter 主要
# 从 /proc 和 /sys 读取指标，不需要 /dev 设备节点。与 ongrid-frontier.service
# 加固基线对齐。
PrivateDevices=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
