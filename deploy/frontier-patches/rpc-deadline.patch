+package exchange
+
+import (
+	"context"
+	"github.com/singchia/frontier/api/dataplane/v1/edge"
+	"github.com/singchia/frontier/api/dataplane/v1/service"
+	"github.com/singchia/geminio"
+	"github.com/stretchr/testify/require"
+	"testing"
+	"time"
+)
+
+// Exercise actual SDK -> broker -> SDK calls, not only timeout selection.
+func TestOngridForwardedRPCDeadline(t *testing.T) {
+	newHarness(t)
+	e, err := edge.NewEdge(edgeDial())
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, e.Close()) })
+	svc, err := service.NewService(svcDial(), service.OptionServiceName("deadline-test"))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, svc.Close()) })
+	handler := func(ctx context.Context, req geminio.Request, resp geminio.Response) {
+		delay, err := time.ParseDuration(string(req.Data()))
+		if err != nil {
+			resp.SetError(err)
+			return
+		}
+		select {
+		case <-time.After(delay):
+			resp.SetData([]byte("finished"))
+		case <-ctx.Done():
+			resp.SetError(ctx.Err())
+		}
+	}
+	require.NoError(t, e.Register(context.Background(), "deadline-edge", handler))
+	require.NoError(t, svc.Register(context.Background(), "deadline-service", handler))
+	time.Sleep(50 * time.Millisecond)
+	for _, direction := range []string{"to-edge", "to-service"} {
+		t.Run(direction, func(t *testing.T) {
+			call := func(ctx context.Context, delay string) (geminio.Response, error) {
+				if direction == "to-edge" {
+					return svc.Call(ctx, e.EdgeID(), "deadline-edge", svc.NewRequest([]byte(delay)))
+				}
+				return e.Call(ctx, "deadline-service", e.NewRequest([]byte(delay)))
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+			resp, err := call(ctx, "31s")
+			cancel()
+			require.NoError(t, err)
+			require.Equal(t, "finished", string(resp.Data()))
+			ctx, cancel = context.WithTimeout(context.Background(), 100*time.Millisecond)
+			started := time.Now()
+			_, err = call(ctx, "5s")
+			cancel()
+			require.Error(t, err)
+			require.Less(t, time.Since(started), 2*time.Second)
+			// Calls without a deadline must still time out at the existing default.
+			started = time.Now()
+			_, err = call(context.Background(), "35s")
+			require.Error(t, err)
+			require.Greater(t, time.Since(started), 29*time.Second)
+			require.Less(t, time.Since(started), 34*time.Second)
+		})
+	}
+}
